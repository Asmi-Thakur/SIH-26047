# ============================================================
# MediKiosk — environment configuration template
# Copy to `.env` and fill in values. NEVER commit `.env`.
# ============================================================

# --- Application ---
APP_ENV=development
DEMO_MODE=true

# --- Database ---
# Docker Compose (host = service name):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/medikiosk
# Local development without Docker (uncomment to use):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medikiosk

# --- Security ---
SESSION_SECRET=replace_me

# --- LLM (kept on the backend only) ---
LLM_PROVIDER=mock
GEMINI_API_KEY=

# --- Speech (kept on the backend only) ---
SPEECH_PROVIDER=mock
SARVAM_API_KEY=

# --- OCR ---
# auto = real PaddleOCR when installed (py3.12 venv + requirements-ocr.txt),
# otherwise the honest simulated provider; "mock" forces simulation;
# "paddleocr" requires the real engine (raises if missing).
OCR_PROVIDER=auto

# --- FHIR ---
# Docker Compose (host = service name):
FHIR_BASE_URL=http://fhir:8080/fhir
# Local development without Docker (uncomment to use):
# FHIR_BASE_URL=http://localhost:8080/fhir

# --- Uploads ---
MAX_UPLOAD_MB=15

# --- CORS (comma-separated origins allowed to call the backend) ---
CORS_ORIGINS=http://127.0.0.1:8000

# ============================================================
# Frontend (read at build/dev time by Vite — prefix VITE_)
# Only public configuration belongs here. NEVER put secrets here.
# ============================================================
VITE_API_BASE_URL=http://127.0.0.1:8000
